#:import T theme

<FormScreen>:
    BoxLayout:
        orientation: 'vertical'
        TopBar:
            title: root.screen_title
        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(16), dp(20), dp(24)]
                spacing: dp(8)
                MutedLabel:
                    text: 'ФИО *'
                AppInput:
                    id: full_name
                    hint_text: 'Иванов Иван Иванович'
                BoxLayout:
                    size_hint_y: None
                    height: dp(74)
                    spacing: dp(10)
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        MutedLabel:
                            text: 'Дата рождения'
                        AppInput:
                            id: birth_date
                            hint_text: 'ДД.ММ.ГГГГ'
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        MutedLabel:
                            text: 'Дата смерти'
                        AppInput:
                            id: death_date
                            hint_text: 'ДД.ММ.ГГГГ'
                MutedLabel:
                    text: 'Биография'
                AreaInput:
                    id: biography
                    hint_text: 'Расскажите о человеке: где жил, чем занимался, каким его помнят'
                MutedLabel:
                    text: 'Места памяти (можно выбрать несколько)'
                StackLayout:
                    id: locations_box
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(6)
                Widget:
                    size_hint_y: None
                    height: dp(8)
                AppButton:
                    text: root.save_text
                    on_release: root.save()
                MutedLabel:
                    text: 'Страницы обычных пользователей публикуются после проверки модератором.'
                    halign: 'center'
