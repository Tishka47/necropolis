#:kivy 2.0
#:import T theme

# ===== Единый дизайн всех экранов =====
# Светлая «бумага», тёмные «чернила», заголовки с засечками, прямые углы,
# тонкие линии вместо карточек — как в печатной книге памяти.

<BaseScreen>:
    canvas.before:
        Color:
            rgba: T.P.BG
        Rectangle:
            pos: self.pos
            size: self.size

# --- Текст ---
<AppLabel@Label>:
    color: T.P.TEXT
    font_size: sp(15)
    markup: True
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1] + dp(6)
    halign: 'left'
    valign: 'top'
    line_height: 1.15

<MutedLabel@AppLabel>:
    color: T.P.MUTED
    font_size: sp(13)

<TitleLabel@AppLabel>:
    font_name: T.SERIF
    color: T.P.TEXT
    font_size: sp(26)
    line_height: 1.05

<SectionLabel@AppLabel>:
    font_name: T.SERIF
    color: T.P.TEXT
    font_size: sp(19)
    valign: 'bottom'
    height: self.texture_size[1] + dp(26)
    canvas.after:
        Color:
            rgba: T.P.RULE
        Line:
            points: self.x, self.y + dp(2), self.right, self.y + dp(2)
            width: 1

# --- Кнопки ---
<AppButton@Button>:
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: T.P.ACCENT if self.state == 'down' else T.P.TEXT
    color: T.P.ON_ACCENT
    disabled_color: T.P.ON_ACCENT
    font_size: sp(15)
    bold: True
    size_hint_y: None
    height: dp(48)
    opacity: 0.45 if self.disabled else 1

<SecondaryButton@AppButton>:
    background_color: T.P.SURFACE_2 if self.state == 'down' else (0, 0, 0, 0)
    color: T.P.TEXT
    disabled_color: T.P.TEXT
    bold: False
    canvas.before:
        Color:
            rgba: T.P.TEXT
        Line:
            rectangle: self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1
            width: 1

<DangerButton@AppButton>:
    background_color: T.P.SURFACE_2 if self.state == 'down' else (0, 0, 0, 0)
    color: T.P.DANGER
    disabled_color: T.P.DANGER
    canvas.before:
        Color:
            rgba: T.P.DANGER
        Line:
            rectangle: self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1
            width: 1

<LinkButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: T.P.ACCENT
    underline: True
    font_size: sp(14)
    size_hint_y: None
    height: dp(40)

# Пункт меню главного экрана: строка как в оглавлении книги
<MenuRow@Button>:
    background_normal: ''
    background_down: ''
    background_color: T.P.SURFACE if self.state == 'down' else (0, 0, 0, 0)
    color: T.P.TEXT
    font_name: T.SERIF
    font_size: sp(19)
    size_hint_y: None
    height: dp(58)
    text_size: self.size
    halign: 'left'
    valign: 'middle'
    padding: [dp(4), 0, dp(36), 0]
    canvas.after:
        Color:
            rgba: T.P.RULE
        Line:
            points: self.x, self.y, self.right, self.y
            width: 1
        Color:
            rgba: self.color
        Line:
            points: self.right - dp(16), self.center_y + dp(6), self.right - dp(10), self.center_y, self.right - dp(16), self.center_y - dp(6)
            width: dp(1.2)

<MenuRowDanger@MenuRow>:
    color: T.P.DANGER

<ChipToggle@ToggleButton>:
    background_normal: ''
    background_down: ''
    background_color: T.P.TEXT if self.state == 'down' else (0, 0, 0, 0)
    color: T.P.ON_ACCENT if self.state == 'down' else T.P.TEXT
    font_size: sp(14)
    size_hint: None, None
    height: dp(36)
    width: self.texture_size[0] + dp(24)
    canvas.before:
        Color:
            rgba: T.P.TEXT
        Line:
            rectangle: self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1
            width: 1

# --- Поля ввода: без подложки, только линия снизу ---
<AppInput@TextInput>:
    multiline: False
    write_tab: False
    size_hint_y: None
    height: dp(46)
    padding: [dp(2), dp(13), dp(2), dp(10)]
    font_size: sp(16)
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: T.P.TEXT
    hint_text_color: T.P.MUTED
    cursor_color: T.P.ACCENT
    cursor_width: dp(1.5)
    selection_color: T.P.ACCENT[:3] + [0.25]
    canvas.after:
        Color:
            rgba: T.P.ACCENT if self.focus else T.P.RULE
        Line:
            points: self.x, self.y + dp(1), self.right, self.y + dp(1)
            width: dp(1.3) if self.focus else 1

<AreaInput@AppInput>:
    multiline: True
    height: dp(130)
    padding: [dp(10), dp(10), dp(10), dp(10)]
    background_color: T.P.SURFACE

<AppSpinner@Spinner>:
    background_normal: ''
    background_down: ''
    background_color: T.P.SURFACE if self.state == 'down' else (0, 0, 0, 0)
    color: T.P.TEXT
    font_size: sp(15)
    size_hint_y: None
    height: dp(46)
    text_size: self.size
    halign: 'left'
    valign: 'middle'
    padding: [dp(2), 0, dp(28), 0]
    canvas.after:
        Color:
            rgba: T.P.RULE
        Line:
            points: self.x, self.y + dp(1), self.right, self.y + dp(1)
            width: 1
        Color:
            rgba: T.P.TEXT
        Triangle:
            points: self.right - dp(18), self.center_y + dp(3), self.right - dp(8), self.center_y + dp(3), self.right - dp(13), self.center_y - dp(3)

<SpinnerOption>:
    background_normal: ''
    background_down: ''
    background_color: T.P.SURFACE_2 if self.state == 'down' else T.P.BG
    color: T.P.TEXT
    height: dp(44)
    canvas.after:
        Color:
            rgba: T.P.RULE
        Line:
            points: self.x, self.y, self.right, self.y
            width: 1

# --- Контейнеры ---
# Блок без подложки: отделяется от соседей тонкой линией сверху.
# rule = False у первого блока после SectionLabel: у заголовка уже есть своя линия.
<Card@BoxLayout>:
    rule: True
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: [0, dp(14), 0, dp(10)]
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: T.P.RULE if self.rule else (0, 0, 0, 0)
        Line:
            points: self.x, self.top, self.right, self.top
            width: 1

# Шапка страницы памяти: как Card, но без линии сверху (над ней уже линия TopBar)
<HeaderBlock@BoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: [0, dp(8), 0, dp(16)]
    spacing: dp(6)

<TopBar@BoxLayout>:
    title: ''
    show_back: True
    size_hint_y: None
    height: dp(56)
    padding: [dp(4), 0, dp(16), 0]
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: T.P.BG
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: T.P.TEXT
        Line:
            points: self.x, self.y, self.right, self.y
            width: 1
    Button:
        text: '‹'
        font_size: sp(34)
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        color: T.P.TEXT
        size_hint_x: None
        width: dp(44) if root.show_back else dp(12)
        opacity: 1 if root.show_back else 0
        disabled: not root.show_back
        on_release: app.root.current_screen.go_back()
    Label:
        text: root.title
        font_name: T.SERIF
        color: T.P.TEXT
        font_size: sp(20)
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'

# --- Диалоги ---
<DialogCard@BoxLayout>:
    accent: T.P.ACCENT
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(20), dp(22), dp(20), dp(18)]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: T.P.BG
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: T.P.TEXT
        Line:
            rectangle: self.x, self.y, self.width, self.height
            width: 1
        Color:
            rgba: self.accent or T.P.ACCENT
        Rectangle:
            pos: self.x, self.top - dp(4)
            size: self.width, dp(4)

<DialogTitle@AppLabel>:
    font_name: T.SERIF
    font_size: sp(21)

<DialogText@AppLabel>:
    font_size: sp(15)
