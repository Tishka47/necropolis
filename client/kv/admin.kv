#:import T theme

<AdminScreen>:
    BoxLayout:
        orientation: 'vertical'
        TopBar:
            title: 'Администрирование'
        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: content
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(8), dp(20), dp(24)]
                spacing: dp(10)
